<UserControl x:Class="LocalChromeStore.Views.ExtensionCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LocalChromeStore.Converters"
             xmlns:vm="clr-namespace:LocalChromeStore.ViewModels"
             d:DataContext="{d:DesignInstance vm:ExtensionCardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="360" Height="240">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: icon + name + version -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon (or placeholder) -->
                <Border Grid.Column="0" Width="48" Height="48"
                        CornerRadius="8" Background="{StaticResource Surface0Brush}"
                        Margin="0,0,12,0">
                    <Grid>
                        <Image Source="{Binding Icon}" Stretch="Uniform" Margin="6"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="◧"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="22"
                                   Foreground="{StaticResource MauveBrush}"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Repo}" Style="{StaticResource MuteText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding Stars}" Style="{StaticResource SubtleText}"
                           VerticalAlignment="Top" Foreground="{StaticResource YellowBrush}" />
            </Grid>

            <!-- Description -->
            <TextBlock Grid.Row="1" Text="{Binding Description}"
                       Style="{StaticResource SubtleText}"
                       TextWrapping="Wrap"
                       MaxHeight="60"
                       TextTrimming="CharacterEllipsis" />

            <!-- Status row -->
            <Grid Grid.Row="2" Margin="0,8,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusBadge}"
                           Foreground="{StaticResource GreenBrush}" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding AssetSummary}" Style="{StaticResource MuteText}"
                           VerticalAlignment="Center" />
            </Grid>

            <!-- Action row -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Busy indicator OR install/uninstall buttons -->
                <TextBlock Grid.Column="0" Text="{Binding BusyMessage}"
                           Foreground="{StaticResource SapphireBrush}"
                           FontSize="11" VerticalAlignment="Center"
                           Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />

                <Button Grid.Column="1"
                        Content="{Binding InstallButtonLabel}"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding InstallCommand}"
                        IsEnabled="{Binding CanInstall}"
                        Margin="0,0,6,0" />
                <Button Grid.Column="2"
                        Content="Uninstall"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding UninstallCommand}"
                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,6,0" />
                <Button Grid.Column="3"
                        Content="Repo"
                        Style="{StaticResource LinkButton}"
                        Command="{Binding OpenRepoCommand}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
