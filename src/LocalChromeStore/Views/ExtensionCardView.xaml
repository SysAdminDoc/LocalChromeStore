<UserControl x:Class="LocalChromeStore.Views.ExtensionCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LocalChromeStore.Converters"
             xmlns:vm="clr-namespace:LocalChromeStore.ViewModels"
             d:DataContext="{d:DesignInstance vm:ExtensionCardViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Width="378" Height="376">
    <UserControl.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />

        <Style x:Key="MetaBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource Surface0Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Surface1Brush}" />
        </Style>

        <Style x:Key="MetaBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource CardBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="52"
                        Height="52"
                        CornerRadius="8"
                        Background="{StaticResource Surface0Brush}"
                        BorderBrush="{StaticResource Surface1Brush}"
                        BorderThickness="1"
                        Margin="0,0,12,0">
                    <Grid>
                        <Image Source="{Binding Icon}"
                               Stretch="Uniform"
                               Margin="7"
                               Visibility="{Binding Icon, Converter={StaticResource NullToVis}}" />
                        <TextBlock Text="EXT"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource MauveBrush}"
                                   Visibility="{Binding Icon, Converter={StaticResource NullToVis}, ConverterParameter=invert}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Repo}"
                               Style="{StaticResource MuteText}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="{Binding Stars}"
                           Style="{StaticResource BadgeText}"
                           Foreground="{StaticResource YellowBrush}"
                           VerticalAlignment="Top" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        CornerRadius="8"
                        Padding="9,4"
                        Margin="0,0,8,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource SapphireSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource SapphireBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GreenSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsUpdateAvailable}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource YellowSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasInstallSource}" Value="False">
                                    <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusBadge}" Style="{StaticResource BadgeText}" />
                </Border>

                <TextBlock Grid.Column="1"
                           Text="{Binding InstalledDetail}"
                           Style="{StaticResource MuteText}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <!-- Catalog explainability badges: framework, manifest version, repo freshness -->
            <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                <Border Style="{StaticResource MetaBadge}"
                        Visibility="{Binding HasFrameworkBadge, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding Info.FrameworkEvidence}">
                    <TextBlock Style="{StaticResource MetaBadgeText}"
                               Foreground="{StaticResource MauveBrush}"
                               Text="{Binding FrameworkBadge}" />
                </Border>
                <Border Visibility="{Binding HasManifestVersionBadge, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding ManifestVersionTooltip}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource MetaBadge}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsManifestV2}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ManifestVersionBadge}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetaBadgeText}">
                                <Setter Property="Foreground" Value="{StaticResource SapphireBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsManifestV2}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Border ToolTip="Source trust tier — based on configured owner, release asset shape, SHA256 sidecar verification, or GitHub API asset digest verification.">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource MetaBadge}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTrustVerified}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource GreenSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource GreenBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTrustVerifiable}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource SapphireSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource SapphireBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTrustSourceOnly}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource YellowSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding TrustBadge}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetaBadgeText}">
                                <Setter Property="Foreground" Value="{StaticResource SubtextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTrustVerified}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTrustVerifiable}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource SapphireBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsTrustSourceOnly}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Border Visibility="{Binding AssetChangedSinceInstall, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding ReleaseProvenanceTooltip}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource MetaBadge}">
                            <Setter Property="Background" Value="{StaticResource YellowSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Asset changed"
                               Style="{StaticResource MetaBadgeText}"
                               Foreground="{StaticResource YellowBrush}" />
                </Border>
                <Border Visibility="{Binding HasFreshnessBadge, Converter={StaticResource BoolToVis}}"
                        ToolTip="Repository freshness from GitHub push activity">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource MetaBadge}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFreshnessWarn}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource YellowSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFreshnessAlert}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding FreshnessBadge}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetaBadgeText}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFreshnessWarn}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFreshnessAlert}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <Border Visibility="{Binding HasUpdatePermissionExpansion, Converter={StaticResource BoolToVis}}"
                        ToolTip="{Binding UpdatePermissionDiff.AddedSummary}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource MetaBadge}">
                            <Setter Property="Background" Value="{StaticResource YellowSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource YellowBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHighRiskUpdatePermissionExpansion}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource RedBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="Review update">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MetaBadgeText}">
                                <Setter Property="Foreground" Value="{StaticResource YellowBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasHighRiskUpdatePermissionExpansion}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
                <!-- F004: localchromestore.json catalog manifest badge -->
                <Border Visibility="{Binding HasRepoManifest, Converter={StaticResource BoolToVis}}"
                        ToolTip="This repo provides a localchromestore.json catalog manifest (F004).">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource MetaBadge}">
                            <Setter Property="Background" Value="{StaticResource TealSoftBrush}" />
                            <Setter Property="BorderBrush" Value="{StaticResource TealBrush}" />
                        </Style>
                    </Border.Style>
                    <TextBlock Text="LCS Manifest"
                               Style="{StaticResource MetaBadgeText}"
                               Foreground="{StaticResource TealBrush}" />
                </Border>
            </WrapPanel>

            <TextBlock Grid.Row="3"
                       Text="{Binding Description}"
                       Style="{StaticResource SubtleText}"
                       TextWrapping="Wrap"
                       MaxHeight="48"
                       TextTrimming="CharacterEllipsis" />

            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="{Binding AssetSummary}"
                           Style="{StaticResource MuteText}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding ReleaseSummary}"
                           Style="{StaticResource MuteText}"
                           Margin="10,0,0,0" />
                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,3,0,0"
                           Text="{Binding ReleaseProvenanceSummary}"
                           ToolTip="{Binding ReleaseProvenanceTooltip}"
                           Style="{StaticResource MuteText}"
                           Foreground="{StaticResource OverlayBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,2,0,0"
                           Text="{Binding SourceSummary}"
                           Style="{StaticResource MuteText}"
                           Foreground="{StaticResource OverlayBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Grid.ColumnSpan="2"
                           Margin="0,2,0,0"
                           Text="{Binding PermissionSummary}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MuteText}">
                            <Setter Property="Foreground" Value="{StaticResource OverlayBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasHighRiskPermissions}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ProgressBar Grid.Row="4"
                             Grid.Column="0"
                             Grid.ColumnSpan="2"
                             IsIndeterminate="True"
                             Margin="0,8,0,0"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <TextBlock Grid.Row="5"
                       Text="{Binding WarningSummary}"
                       Foreground="{StaticResource YellowBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVis}}" />

            <TextBlock Grid.Row="6"
                       Text="{Binding BusyMessage}"
                       Foreground="{StaticResource SapphireBrush}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Margin="0,4,0,0"
                       Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />

            <Grid Grid.Row="7" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Row="0"
                        Grid.Column="1"
                        Content="{Binding InstallButtonLabel}"
                        Style="{StaticResource AccentButton}"
                        Command="{Binding InstallCommand}"
                        IsEnabled="{Binding CanInstall}"
                        MinWidth="96"
                        Margin="0,0,6,0" />
                <Button Grid.Row="0"
                        Grid.Column="2"
                        Content="Uninstall"
                        Style="{StaticResource DangerButton}"
                        Command="{Binding UninstallCommand}"
                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,6,0" />
                <Button Grid.Row="0"
                        Grid.Column="3"
                        Content="Folder"
                        Command="{Binding OpenInstallDirCommand}"
                        IsEnabled="{Binding CanOpenInstallDir}"
                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}" />

                <WrapPanel Grid.Row="1"
                           Grid.Column="0"
                           Grid.ColumnSpan="4"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           Margin="0,7,0,0">
                    <Button Content="Policy"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding ApplyPolicyCommand}"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                            ToolTip="Package this installed extension as CRX3/update.xml and apply Enterprise Policy force-install for the selected browser."
                            Margin="0,0,4,0" />
                    <Button Content="Rollback"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding RollbackPolicyCommand}"
                            Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                            ToolTip="Remove only this extension's Enterprise Policy registry entries for the selected browser."
                            Margin="0,0,4,0" />
                    <Button Content="Inspect"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding InspectCommand}"
                            ToolTip="Open the manifest risk panel — permissions, host access, and trust signals before install."
                            Margin="0,0,4,0" />
                    <!-- F004: homepage link when repo manifest provides one -->
                    <Button Content="Home"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding OpenHomepageCommand}"
                            Visibility="{Binding HasHomepageUrl, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding Info.HomepageUrl}"
                            Margin="0,0,4,0" />
                    <!-- F026: copy build command to clipboard when framework is known -->
                    <Button Content="Copy Build Cmd"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding CopyBuildCommandCommand}"
                            Visibility="{Binding HasBuildCommand, Converter={StaticResource BoolToVis}}"
                            ToolTip="{Binding BuildCommand}"
                            Margin="0,0,4,0" />
                    <Button Content="Why"
                            Style="{StaticResource LinkButton}"
                            ToolTipService.InitialShowDelay="200"
                            ToolTipService.ShowDuration="20000"
                            Margin="0,0,4,0">
                        <Button.ToolTip>
                            <ToolTip MaxWidth="420">
                                <TextBlock Text="{Binding WhyShownDetail}"
                                           TextWrapping="Wrap"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="11" />
                            </ToolTip>
                        </Button.ToolTip>
                    </Button>
                    <Button Content="Hide"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding HideRepositoryCommand}"
                            Margin="0,0,4,0" />
                    <Button Content="Repo"
                            Style="{StaticResource LinkButton}"
                            Command="{Binding OpenRepoCommand}" />
                </WrapPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
