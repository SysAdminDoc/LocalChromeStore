<Window x:Class="LocalChromeStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalChromeStore.ViewModels"
        xmlns:views="clr-namespace:LocalChromeStore.Views"
        xmlns:conv="clr-namespace:LocalChromeStore.Converters"
        Title="LocalChromeStore" Height="820" Width="1280"
        MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVis" />
    </Window.Resources>

    <Grid Background="{StaticResource BaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="168" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="8"
                        Background="{StaticResource MauveSoftBrush}"
                        BorderBrush="{StaticResource MauveBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0">
                    <TextBlock Text="LCS"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MauveBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="LocalChromeStore" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="A private catalog for Chromium extensions built from your GitHub releases."
                               Style="{StaticResource SubtleText}" />
                    <TextBlock Style="{StaticResource MuteText}" Margin="0,3,0,0">
                        <Run Text="{Binding AvailableCount, Mode=OneWay}" />
                        <Run Text=" available" />
                        <Run Text=" / " Foreground="{StaticResource MuteBrush}" />
                        <Run Text="{Binding InstalledCount, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" />
                        <Run Text=" installed" />
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource MantleBrush}"
                Padding="20,12"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="470" MinWidth="320">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Search extensions, repositories, or descriptions"
                                   Style="{StaticResource MuteText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyStringToVis}}" />
                    </Grid>

                    <CheckBox Grid.Column="2"
                              Content="Installed only"
                              IsChecked="{Binding ShowInstalledOnly}"
                              VerticalAlignment="Center"
                              Margin="18,0" />

                    <Button Grid.Column="3"
                            Content="{Binding RefreshButtonLabel}"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource AccentButton}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="4"
                            Content="Settings"
                            x:Name="SettingsToggleButton"
                            Click="ToggleSettings_Click" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding BrowserSummary}"
                               Style="{StaticResource MuteText}"
                               Margin="2,0,12,0"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Browsers}"
                              SelectedItem="{Binding SelectedBrowser}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="190"
                              Margin="0,0,8,0"
                              ToolTip="{Binding BrowserSummary}" />

                    <Button Grid.Column="2"
                            Content="Install folder"
                            Command="{Binding OpenInstallDirCommand}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="3"
                            Content="{Binding ExtensionsPageLabel}"
                            Command="{Binding OpenBrowserExtensionsPageCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Opens chrome://extensions (or edge://extensions) in the selected browser." />

                    <Button Grid.Column="4"
                            Content="Launch session"
                            Command="{Binding LaunchBrowserCommand}"
                            Style="{StaticResource AccentButton}"
                            ToolTip="Launches the selected browser with every installed extension loaded through --load-extension." />
                </Grid>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MuteText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <Run Text="{Binding GitHubStatusSummary, Mode=OneWay}" />
                        <Run Text="  •  " Foreground="{StaticResource OverlayBrush}" />
                        <Run Text="{Binding RateLimitSummary, Mode=OneWay}" />
                    </TextBlock>
                    <Border Grid.Column="1"
                            CornerRadius="6"
                            Padding="8,2"
                            Background="{StaticResource RedSoftBrush}"
                            BorderBrush="{StaticResource RedBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsDegraded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Degraded"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RedBrush}" />
                    </Border>
                </Grid>

                <ProgressBar Grid.Row="3"
                             IsIndeterminate="True"
                             Margin="0,10,0,0"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <Border x:Name="SettingsDrawer"
                Grid.Row="2"
                Style="{StaticResource PanelBorder}"
                Margin="20,14,20,0"
                Padding="18"
                Visibility="Collapsed"
                Effect="{StaticResource PanelShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Discovery settings" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Configure the GitHub source, topic filter, and rate-limit token used for discovery."
                                   Style="{StaticResource SubtleText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Close"
                            Click="ToggleSettings_Click"
                            Style="{StaticResource LinkButton}"
                            VerticalAlignment="Top" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="GitHub user or organization" Style="{StaticResource InputLabel}" />
                        <Grid>
                            <TextBox x:Name="GitHubUserBox"
                                     Text="{Binding GitHubUserInput, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="example: SysAdminDoc"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=GitHubUserBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>

                        <TextBlock Text="GitHub personal access token"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,12,0,5" />
                        <PasswordBox x:Name="GitHubTokenBox"
                                     PasswordChanged="GitHubTokenBox_PasswordChanged" />
                        <TextBlock Text="Optional. Stored only in your local settings file; leave blank to use public GitHub rate limits."
                                   Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />

                        <TextBlock Text="Extra owners"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,16,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="NewOwnerBox"
                                         Text="{Binding NewOwnerInput, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Text="Add another GitHub user or org"
                                           Style="{StaticResource MuteText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=NewOwnerBox, Converter={StaticResource EmptyStringToVis}}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Content="Add"
                                    Command="{Binding AddExtraOwnerCommand}"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <Border Background="{StaticResource CrustBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="6"
                                Margin="0,8,0,0">
                            <Grid>
                                <ListBox ItemsSource="{Binding ExtraOwners}"
                                         SelectedItem="{Binding SelectedExtraOwner}"
                                         MaxHeight="118"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                CornerRadius="5"
                                                                Padding="8,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding}"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Button Grid.Column="1"
                                                                        Content="Remove"
                                                                        Style="{StaticResource LinkButton}"
                                                                        Command="{Binding DataContext.RemoveExtraOwnerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MauveSoftBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock Text="No extra owners. Add a GitHub user or org above to discover their repos too."
                                           Style="{StaticResource MuteText}"
                                           TextWrapping="Wrap"
                                           Margin="6"
                                           Visibility="{Binding HasExtraOwners, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <CheckBox Content="Filter by GitHub topic"
                                  IsChecked="{Binding UseTopicFilter}" />
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="TopicFilterBox"
                                     Text="{Binding TopicFilter, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseTopicFilter}" />
                            <TextBlock Text="chrome-extension"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=TopicFilterBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="When enabled, discovery only shows repos tagged with the selected topic. Otherwise any repo with a manifest.json or release ZIP/CRX can appear." />

                        <Border Background="{StaticResource CrustBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,14,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="Hidden repositories" Style="{StaticResource InputLabel}" />
                                    <TextBlock Text="{Binding HiddenRepoSummary}"
                                               Style="{StaticResource MuteText}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Content="Restore"
                                        Command="{Binding ClearHiddenReposCommand}"
                                        IsEnabled="{Binding HasHiddenRepos}"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="Use Hide on a card to keep noisy repos out of future refreshes without changing GitHub or local install files."
                                           Style="{StaticResource MuteText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                MinWidth="170"
                                VerticalAlignment="Bottom">
                        <Button Content="Save and refresh"
                                Command="{Binding SaveAndRefreshCommand}"
                                Style="{StaticResource AccentButton}"
                                Margin="0,0,0,8" />
                        <Button Content="Save settings"
                                Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,14,12,16">
                <ItemsControl ItemsSource="{Binding ExtensionsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:ExtensionCardView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520"
                    Padding="24"
                    Style="{StaticResource PanelBorder}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyStateTitle}"
                               Style="{StaticResource SectionTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               Style="{StaticResource SubtleText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Refresh catalog"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource AccentButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Open settings"
                                Click="ToggleSettings_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="20,8,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Activity log" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Download, install, launch, and error events"
                               Style="{StaticResource MuteText}"
                               Margin="10,1,0,0" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="Clear"
                        Command="{Binding ClearLogCommand}"
                        Style="{StaticResource LinkButton}"
                        Margin="0,0,16,0" />
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="{StaticResource CrustBrush}" Padding="16,10">
            <ListBox ItemsSource="{Binding LogLines}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="11"
                     Foreground="{StaticResource SubtextBrush}"
                     x:Name="LogList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0,1" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Border Grid.Row="6"
                Background="{StaticResource CrustBrush}"
                Padding="16,7"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource SubtleText}" />
                <TextBlock Grid.Column="1" Style="{StaticResource MuteText}">
                    <Run Text="LocalChromeStore v0.1.0" />
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</Window>
