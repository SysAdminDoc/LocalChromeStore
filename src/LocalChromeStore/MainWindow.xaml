<Window x:Class="LocalChromeStore.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LocalChromeStore.ViewModels"
        xmlns:views="clr-namespace:LocalChromeStore.Views"
        xmlns:conv="clr-namespace:LocalChromeStore.Converters"
        Title="LocalChromeStore" Height="820" Width="1280"
        MinWidth="920" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EmptyStringToVisibilityConverter x:Key="EmptyStringToVis" />
    </Window.Resources>

    <DockPanel Background="{StaticResource BaseBrush}">
        <Border DockPanel.Dock="Top"
                x:Name="SelfUpdateBanner"
                Background="{StaticResource MauveSoftBrush}"
                BorderBrush="{StaticResource MauveBrush}"
                BorderThickness="0,0,0,1"
                Padding="22,10"
                Visibility="{Binding SelfUpdateAvailable, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"
                           Text="{Binding SelfUpdateMessage}"
                           AutomationProperties.Name="Application update notice" />
                <Button Grid.Column="1"
                        Content="Download update"
                        Command="{Binding OpenSelfUpdateCommand}"
                        Style="{StaticResource AccentButton}"
                        Margin="12,0,8,0"
                        AutomationProperties.Name="Open the LocalChromeStore release page" />
                <Button Grid.Column="2"
                        Content="Dismiss"
                        Command="{Binding DismissSelfUpdateCommand}"
                        AutomationProperties.Name="Dismiss the update notice" />
            </Grid>
        </Border>

        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="168" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CrustBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1"
                Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="44"
                        Height="44"
                        CornerRadius="8"
                        Background="{StaticResource MauveSoftBrush}"
                        BorderBrush="{StaticResource MauveBrush}"
                        BorderThickness="1"
                        Margin="0,0,14,0">
                    <TextBlock Text="LCS"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource MauveBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="LocalChromeStore" Style="{StaticResource HeadingText}" />
                    <TextBlock Text="A private catalog for Chromium extensions built from your GitHub releases."
                               Style="{StaticResource SubtleText}" />
                    <TextBlock Style="{StaticResource MuteText}" Margin="0,3,0,0">
                        <Run Text="{Binding AvailableCount, Mode=OneWay}" />
                        <Run Text=" available" />
                        <Run Text=" / " Foreground="{StaticResource MuteBrush}" />
                        <Run Text="{Binding InstalledCount, Mode=OneWay}" Foreground="{StaticResource GreenBrush}" />
                        <Run Text=" installed" />
                        <Run Text=" / " Foreground="{StaticResource MuteBrush}" />
                        <Run Text="{Binding UpdateAvailableCount, Mode=OneWay}" Foreground="{StaticResource YellowBrush}" />
                        <Run Text=" updates" />
                    </TextBlock>
                </StackPanel>

            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="{StaticResource MantleBrush}"
                Padding="20,12"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="470" MinWidth="320">
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Search extensions" />
                        <TextBlock Text="Search extensions, repositories, or descriptions"
                                   Style="{StaticResource MuteText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource EmptyStringToVis}}" />
                    </Grid>

                    <CheckBox Grid.Column="2"
                              Content="Installed only"
                              IsChecked="{Binding ShowInstalledOnly}"
                              VerticalAlignment="Center"
                              Margin="18,0" />

                    <Button Grid.Column="3"
                            Content="{Binding RefreshButtonLabel}"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource AccentButton}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="4"
                            Content="Settings"
                            x:Name="SettingsToggleButton"
                            Click="ToggleSettings_Click" />
                </Grid>

                <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Grid.Column="0"
                               Text="{Binding BrowserSummary}"
                               Style="{StaticResource MuteText}"
                               Margin="2,0,12,0"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Browsers}"
                              SelectedItem="{Binding SelectedBrowser}"
                              DisplayMemberPath="DisplayName"
                              AutomationProperties.Name="Browser"
                              MinWidth="190"
                              Margin="0,0,8,0"
                              ToolTip="{Binding BrowserSummary}" />

                    <Button Grid.Column="2"
                            Content="Install folder"
                            Command="{Binding OpenInstallDirCommand}"
                            Margin="0,0,8,0" />

                    <Button Grid.Column="3"
                            Content="{Binding ExtensionsPageLabel}"
                            Command="{Binding OpenBrowserExtensionsPageCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Opens chrome://extensions (or edge://extensions) in the selected browser." />

                    <Button Grid.Column="4"
                            Content="{Binding PolicyPageLabel}"
                            Command="{Binding OpenPolicyPageCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Opens chrome://policy (or edge://policy) to inspect active browser policies." />

                    <Button Grid.Column="5"
                            Content="Policy check"
                            Command="{Binding ReviewPolicyReadinessCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Logs Enterprise Policy registry target and off-store force-install enrollment readiness." />

                    <Button Content="Get CfT"
                            Command="{Binding InstallChromeForTestingCommand}"
                            Margin="0,0,8,0"
                            ToolTip="Downloads the latest Stable Chrome for Testing into LocalChromeStore's cache and selects it." />

                    <TextBlock Grid.Column="6"
                               Text="Load set"
                               Style="{StaticResource InputLabel}"
                               Margin="8,0,6,0"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Column="7"
                              ItemsSource="{Binding LoadSets}"
                              SelectedItem="{Binding SelectedLoadSet}"
                              DisplayMemberPath="Name"
                              AutomationProperties.Name="Load set"
                              MinWidth="150"
                              Margin="0,0,8,0"
                              ToolTip="{Binding ActiveLoadSetLabel}" />

                    <Button Grid.Column="8"
                            Content="Launch session"
                            Command="{Binding LaunchBrowserCommand}"
                            Style="{StaticResource AccentButton}"
                            ToolTip="Launches the selected browser with installed extensions for the active load set using the best supported load strategy." />

                    <Button Grid.Column="9"
                            Content="{Binding UpdateAllLabel}"
                            Command="{Binding UpdateAllCommand}"
                            HorizontalAlignment="Left"
                            Margin="8,0,0,0"
                            ToolTip="{Binding UpdateStatusSummary}" />
                </WrapPanel>

                <Grid Grid.Row="2" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Startup URL"
                               Style="{StaticResource InputLabel}"
                               Margin="2,0,8,0"
                               VerticalAlignment="Center" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="LaunchUrlBox"
                                 Text="{Binding LaunchUrlInput, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Startup URL"
                                 ToolTip="Optional URL to open after loading installed extensions." />
                        <TextBlock Text="Optional URL for launch sessions"
                                   Style="{StaticResource MuteText}"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=LaunchUrlBox, Converter={StaticResource EmptyStringToVis}}" />
                    </Grid>

                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding LaunchProfileModes}"
                              SelectedValue="{Binding LaunchProfileMode}"
                              SelectedValuePath="Mode"
                              DisplayMemberPath="Label"
                              AutomationProperties.Name="Browser profile mode"
                              MinWidth="130"
                              ToolTip="{Binding LaunchProfileModeToolTip}"
                              VerticalAlignment="Center"
                              Margin="14,0,10,0" />

                    <Button Grid.Column="3"
                            Content="Copy args"
                            Command="{Binding CopyLaunchArgumentsCommand}"
                            ToolTip="Copy the exact browser command LocalChromeStore will run." />

                    <TextBlock Grid.Column="4"
                               Text="{Binding LaunchProfileSummary}"
                               Style="{StaticResource MuteText}"
                               TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center" />
                </Grid>

                <TextBlock Grid.Row="3"
                           Margin="2,7,0,0"
                           Style="{StaticResource MuteText}"
                           Text="{Binding LaunchPreview}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding LaunchPreview}" />

                <Border Grid.Row="4"
                        Margin="2,8,0,0"
                        Padding="10,8"
                        Background="{StaticResource CrustBrush}"
                        BorderBrush="{StaticResource Surface0Brush}"
                        BorderThickness="1"
                        CornerRadius="7">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Text="Browser path"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,0,10,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding LaunchDebugBrowserPath}"
                                   ToolTip="{Binding LaunchDebugBrowserPath}"
                                   Style="{StaticResource MuteText}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Text="Profile path"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,0,10,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding LaunchDebugProfilePath}"
                                   ToolTip="{Binding LaunchDebugProfilePath}"
                                   Style="{StaticResource MuteText}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Text="Loaded"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,0,10,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1"
                                   Text="{Binding LaunchDebugLoadedExtensions}"
                                   ToolTip="{Binding LaunchDebugLoadedExtensions}"
                                   Style="{StaticResource MuteText}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Text="Startup URL"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,0,10,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1"
                                   Text="{Binding LaunchDebugStartupUrl}"
                                   ToolTip="{Binding LaunchDebugStartupUrl}"
                                   Style="{StaticResource MuteText}"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,4" />

                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Text="Arguments"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,0,10,0" />
                        <TextBlock Grid.Row="4" Grid.Column="1"
                                   Text="{Binding LaunchDebugArguments}"
                                   ToolTip="{Binding LaunchDebugArguments}"
                                   Style="{StaticResource MuteText}"
                                   FontFamily="Cascadia Mono, Consolas"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Border>

                <Grid Grid.Row="5" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource MuteText}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center">
                        <Run Text="{Binding GitHubStatusSummary, Mode=OneWay}" />
                        <Run Text="  •  " Foreground="{StaticResource OverlayBrush}" />
                        <Run Text="{Binding RateLimitSummary, Mode=OneWay}" />
                    </TextBlock>
                    <Border Grid.Column="1"
                            CornerRadius="6"
                            Padding="8,2"
                            Background="{StaticResource RedSoftBrush}"
                            BorderBrush="{StaticResource RedBrush}"
                            BorderThickness="1"
                            Visibility="{Binding IsDegraded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Degraded"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RedBrush}" />
                    </Border>
                </Grid>

                <ProgressBar Grid.Row="6"
                             IsIndeterminate="True"
                             Margin="0,10,0,0"
                             Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>

        <Border x:Name="SettingsDrawer"
                Grid.Row="2"
                Style="{StaticResource PanelBorder}"
                Margin="20,14,20,0"
                Padding="18"
                Visibility="Collapsed"
                Effect="{StaticResource PanelShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Discovery settings" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Configure the GitHub source, topic filter, and rate-limit token used for discovery."
                                   Style="{StaticResource SubtleText}" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="Close"
                            Click="ToggleSettings_Click"
                            Style="{StaticResource LinkButton}"
                            VerticalAlignment="Top" />
                </Grid>

                <ScrollViewer Grid.Row="1"
                              MaxHeight="360"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                        <TextBlock Text="GitHub user or organization" Style="{StaticResource InputLabel}" />
                        <Grid>
                            <TextBox x:Name="GitHubUserBox"
                                     Text="{Binding GitHubUserInput, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="GitHub user or organization" />
                            <TextBlock Text="example: SysAdminDoc"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=GitHubUserBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>

                        <TextBlock Text="GitHub personal access token"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,12,0,5" />
                        <PasswordBox x:Name="GitHubTokenBox"
                                     PasswordChanged="GitHubTokenBox_PasswordChanged"
                                     AutomationProperties.Name="GitHub personal access token" />
                        <TextBlock Text="Optional. Stored only in your local settings file; leave blank to use public GitHub rate limits."
                                   Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />

                        <TextBlock Text="Extra owners"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,16,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="NewOwnerBox"
                                         Text="{Binding NewOwnerInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Add extra owner" />
                                <TextBlock Text="Add another GitHub user or org"
                                           Style="{StaticResource MuteText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=NewOwnerBox, Converter={StaticResource EmptyStringToVis}}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Content="Add"
                                    Command="{Binding AddExtraOwnerCommand}"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <Border Background="{StaticResource CrustBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="6"
                                Margin="0,8,0,0">
                            <Grid>
                                <ListBox ItemsSource="{Binding ExtraOwners}"
                                         SelectedItem="{Binding SelectedExtraOwner}"
                                         MaxHeight="118"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                CornerRadius="5"
                                                                Padding="8,5">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding}"
                                                                           Foreground="{StaticResource TextBrush}"
                                                                           VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <Button Grid.Column="1"
                                                                        Content="Remove"
                                                                        Style="{StaticResource LinkButton}"
                                                                        Command="{Binding DataContext.RemoveExtraOwnerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource MauveSoftBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                                <TextBlock Text="No extra owners. Add a GitHub user or org above to discover their repos too."
                                           Style="{StaticResource MuteText}"
                                           TextWrapping="Wrap"
                                           Margin="6"
                                           Visibility="{Binding HasExtraOwners, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>

                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                        <CheckBox Content="Filter by GitHub topic"
                                  IsChecked="{Binding UseTopicFilter}" />
                        <Grid Margin="0,8,0,0">
                            <TextBox x:Name="TopicFilterBox"
                                     Text="{Binding TopicFilter, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding UseTopicFilter}"
                                     AutomationProperties.Name="Topic filter" />
                            <TextBlock Text="chrome-extension"
                                       Style="{StaticResource MuteText}"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=TopicFilterBox, Converter={StaticResource EmptyStringToVis}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Text="When enabled, discovery only shows repos tagged with the selected topic. Otherwise any repo with a manifest.json or release ZIP/CRX can appear." />

                        <TextBlock Text="Local source folders"
                                   Style="{StaticResource InputLabel}"
                                   Margin="0,16,0,5" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox x:Name="NewLocalSourceBox"
                                         Text="{Binding NewLocalSourceInput, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Add local source folder" />
                                <TextBlock Text="C:\dev\my-extension"
                                           Style="{StaticResource MuteText}"
                                           Margin="12,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="{Binding Text, ElementName=NewLocalSourceBox, Converter={StaticResource EmptyStringToVis}}" />
                            </Grid>
                            <Button Grid.Column="1"
                                    Content="Add"
                                    Command="{Binding AddLocalSourceFolderCommand}"
                                    Margin="8,0,0,0" />
                        </Grid>
                        <TextBlock Text="Adds an unpacked extension folder that contains a root manifest.json."
                                   Style="{StaticResource MuteText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,0" />
                        <Border Background="{StaticResource CrustBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="6"
                                Margin="0,8,0,0">
                            <Grid>
                                <ListBox ItemsSource="{Binding LocalSourceFolders}"
                                         SelectedItem="{Binding SelectedLocalSourceFolder}"
                                         MaxHeight="96"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding}"
                                                           Foreground="{StaticResource TextBrush}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <Button Grid.Column="1"
                                                        Content="Remove"
                                                        Style="{StaticResource LinkButton}"
                                                        Command="{Binding DataContext.RemoveLocalSourceFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="No local source folders. Add an unpacked extension folder above to link it during refresh."
                                           Style="{StaticResource MuteText}"
                                           TextWrapping="Wrap"
                                           Margin="6"
                                           Visibility="{Binding HasLocalSourceFolders, Converter={StaticResource BoolToVis}, ConverterParameter=invert}" />
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource CrustBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Install and update flow" Style="{StaticResource InputLabel}" />
                                <CheckBox Content="Launch browser after install"
                                          IsChecked="{Binding LaunchBrowserAfterInstall}"
                                          ToolTip="After a successful install or update, open the selected browser with installed extensions loaded." />
                                <CheckBox Content="Auto-update on refresh"
                                          IsChecked="{Binding AutoUpdateOnRefresh}"
                                          Margin="0,8,0,0"
                                          ToolTip="When refresh finds installed extensions with newer release assets or local sources, update them automatically. Updates that add permissions are skipped until manual review." />
                                <TextBlock Text="{Binding UpdateStatusSummary}"
                                           Style="{StaticResource MuteText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CrustBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Hidden repositories" Style="{StaticResource InputLabel}" />
                                        <TextBlock Text="{Binding HiddenRepoSummary}"
                                                   Style="{StaticResource MuteText}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Restore all"
                                            Command="{Binding ClearHiddenReposCommand}"
                                            IsEnabled="{Binding HasHiddenRepos}"
                                            AutomationProperties.Name="Restore all hidden repositories"
                                            VerticalAlignment="Top" />
                                </Grid>
                                <Border Background="{StaticResource BaseBrush}"
                                        BorderBrush="{StaticResource Surface0Brush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="0,8,0,0"
                                        MaxHeight="90"
                                        Visibility="{Binding HasHiddenRepos, Converter={StaticResource BoolToVis}}">
                                    <ListBox ItemsSource="{Binding HiddenRepos}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             AutomationProperties.Name="Hidden repositories list">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="BorderThickness" Value="0" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Bd"
                                                                    Background="Transparent"
                                                                    CornerRadius="4"
                                                                    Padding="6,3">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding}"
                                                                               Foreground="{StaticResource SubtextBrush}"
                                                                               FontSize="11"
                                                                               VerticalAlignment="Center"
                                                                               TextTrimming="CharacterEllipsis" />
                                                                    <Button Grid.Column="1"
                                                                            Content="Restore"
                                                                            Style="{StaticResource LinkButton}"
                                                                            Command="{Binding DataContext.RestoreHiddenRepoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" />
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                    </ListBox>
                                </Border>
                                <TextBlock Text="Use Hide on a card to keep noisy repos out of future refreshes without changing GitHub or local install files."
                                           Style="{StaticResource MuteText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CrustBrush}"
                                BorderBrush="{StaticResource Surface0Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Named load sets" Style="{StaticResource InputLabel}" />
                                <TextBlock Text="Snapshot the current installed extensions as a named launch profile. Select it in the toolbar to scope 'Launch session' to that subset."
                                           Style="{StaticResource MuteText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="NewLoadSetNameBox"
                                                 Text="{Binding NewLoadSetNameInput, UpdateSourceTrigger=PropertyChanged}"
                                                 AutomationProperties.Name="New load set name" />
                                        <TextBlock Text="New load set name"
                                                   Style="{StaticResource MuteText}"
                                                   Margin="12,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Visibility="{Binding Text, ElementName=NewLoadSetNameBox, Converter={StaticResource EmptyStringToVis}}" />
                                    </Grid>
                                    <Button Grid.Column="1"
                                            Content="Snapshot"
                                            Command="{Binding CreateLoadSetCommand}"
                                            AutomationProperties.Name="Create named load set from installed extensions"
                                            Margin="8,0,0,0" />
                                </Grid>
                                <Border Background="{StaticResource BaseBrush}"
                                        BorderBrush="{StaticResource Surface0Brush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4"
                                        Margin="0,8,0,0"
                                        MaxHeight="90">
                                    <Grid>
                                        <ListBox ItemsSource="{Binding LoadSets}"
                                                 SelectedItem="{Binding SelectedLoadSet}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 AutomationProperties.Name="Load sets">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <Border x:Name="Bd"
                                                                        Background="Transparent"
                                                                        CornerRadius="4"
                                                                        Padding="6,3">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding Name}"
                                                                                   Foreground="{StaticResource TextBrush}"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <Button Grid.Column="1"
                                                                                Content="Delete"
                                                                                Style="{StaticResource LinkButton}"
                                                                                Command="{Binding DataContext.DeleteLoadSetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                Visibility="{Binding Id, Converter={StaticResource EmptyStringToVis}}" />
                                                                    </Grid>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface0Brush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource MauveSoftBrush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </Grid>
                                </Border>
                                <Button Content="Delete selected"
                                        Command="{Binding DeleteLoadSetCommand}"
                                        HorizontalAlignment="Left"
                                        AutomationProperties.Name="Delete selected load set"
                                        Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                MinWidth="170"
                                VerticalAlignment="Bottom">
                        <Button Content="Save and refresh"
                                Command="{Binding SaveAndRefreshCommand}"
                                Style="{StaticResource AccentButton}"
                                Margin="0,0,0,8" />
                        <Button Content="Save settings"
                                Command="{Binding SaveSettingsCommand}" />
                    </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,14,12,16">
                <ItemsControl ItemsSource="{Binding ExtensionsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:ExtensionCardView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520"
                    Padding="24"
                    Style="{StaticResource PanelBorder}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyStateTitle}"
                               Style="{StaticResource SectionTitle}"
                               TextAlignment="Center" />
                    <TextBlock Text="{Binding EmptyStateMessage}"
                               Style="{StaticResource SubtleText}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,18" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Refresh catalog"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource AccentButton}"
                                Margin="0,0,8,0" />
                        <Button Content="Open settings"
                                Click="ToggleSettings_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{StaticResource MantleBrush}"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Margin="20,8,12,8"
                            VerticalAlignment="Center">
                    <TextBlock Text="Activity log" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Download, install, launch, and error events"
                               Style="{StaticResource MuteText}"
                               Margin="10,1,0,0" />
                    <Button Content="Import"
                            Command="{Binding ImportEnvironmentCommand}"
                            Style="{StaticResource LinkButton}"
                            Margin="18,0,0,0"
                            ToolTip="Load a LocalChromeStore environment JSON and install matching missing/outdated extensions." />
                    <Button Content="Export"
                            Command="{Binding ExportEnvironmentCommand}"
                            Style="{StaticResource LinkButton}"
                            ToolTip="Save installed extension targets and portable discovery settings as JSON." />
                    <Button Content="Diagnostics"
                            Command="{Binding ExportDiagnosticsCommand}"
                            Style="{StaticResource LinkButton}"
                            ToolTip="Save a text bundle with paths, GitHub state, browsers, installed extensions, and the activity log." />
                    <Button Content="Conformance"
                            Command="{Binding RunBrowserConformanceCommand}"
                            Style="{StaticResource LinkButton}"
                            ToolTip="Launch a tiny fixture extension in isolated profiles and write browser loading reports." />
                    <Button Content="Catalog"
                            Command="{Binding ExportCatalogCommand}"
                            Style="{StaticResource LinkButton}"
                            ToolTip="Save a machine-readable JSON snapshot of all catalog entries (installed status, asset info, readiness)." />
                    <Button Content="Clear"
                            Command="{Binding ClearLogCommand}"
                            Style="{StaticResource LinkButton}"
                            Margin="4,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="{StaticResource CrustBrush}" Padding="16,10">
            <ListBox ItemsSource="{Binding LogLines}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Mono, Consolas"
                     FontSize="11"
                     Foreground="{StaticResource SubtextBrush}"
                     x:Name="LogList">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Padding" Value="0,1" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Border Grid.Row="6"
                Background="{StaticResource CrustBrush}"
                Padding="16,7"
                BorderBrush="{StaticResource Surface0Brush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           Style="{StaticResource SubtleText}" />
                <TextBlock Grid.Column="1" Style="{StaticResource MuteText}"
                           Text="{Binding AppVersionLabel}" />
            </Grid>
        </Border>
        </Grid>
    </DockPanel>
</Window>
